#!/bin/bash
# FoxAI Browser - Arch package install script
# Called by makepkg after package(); sets up AppImage + icons.

post_install() {
  # Register desktop file
  update-desktop-database -q 2>/dev/null || true
  gtk-update-icon-cache -q -f /usr/share/icons/hicolor 2>/dev/null || true
  echo "FoxAI Browser installed. Run 'foxai-browser' to launch."
  echo "Offline AI: 'foxai-browser --offline' (downloads qwen2.5-3b model on first run)"
}

pre_upgrade() {
  post_install
}

post_upgrade() {
  post_install
}

pre_remove() {
  update-desktop-database -q 2>/dev/null || true
}

post_remove() {
  echo "FoxAI Browser removed. AppImage data under ~/.foxai-browser if present."
}
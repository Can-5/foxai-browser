{
  "policies": {
    "SearchEngines": {
      "Default": "DuckDuckGo",
      "PreventInstalls": false
    },
    "DisableAppUpdate": true,
    "DisableFirefoxStudies": true,
    "DisableTelemetry": true,
    "OverrideFirstRunPage": "",
    "OverridePostUpdatePage": "",
    "ExtensionSettings": {
      "foxai-core@foxai.browser": { "installation_mode": "force_installed", "default_area": "toolbar" },
      "foxai-search-startpage@foxai.local": { "installation_mode": "force_installed" },
      "foxai-ai@foxai.browser": { "installation_mode": "force_installed" },
      "uBlock0@raymondhill.net": { "installation_mode": "force_installed" }
    }
  }
}

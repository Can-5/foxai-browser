# FoxAI shared mozconfig fragment, sourced by every root .mozconfig* file.
# Adapted from BrowserWorks/waterfox waterfox/build/mozconfig.common
# (Waterfox G6.7.x era). Deltas vs upstream are marked FOXAI below.
# It must never write to stdout or stderr: mach's mozconfig loader treats any
# stray output while sourcing as a parse error.
#
# Entry files select a profile through lowercase fx_* shell variables set
# before sourcing (lowercase is required: init.configure forwards uppercase
# shell variables to configure):
#
#   fx_target            target triple; selects the release/CI profile.
#                        Empty selects the local development profile.
#   fx_dev=1             set by .mozconfig to acknowledge the development
#                        profile; sourcing with neither this nor fx_target
#                        set is an error.
#   fx_cross_build=1     export CROSS_BUILD=1
#   fx_lto_mode          cross | thin; empty emits plain --enable-lto
#   fx_optimize          --enable-optimize value for (pre-)release builds
#   fx_rustflags         appended to RUSTFLAGS in (pre-)release builds
#   fx_rustc_bootstrap=1 adds mk_add_options "export RUSTC_BOOTSTRAP=1"
#                        (needed when fx_rustflags uses -Z flags)
#   fx_pgo               native: unconditional MOZ_PGO=1
#                        cross: profile-generate/use when GEN_PGO/USE_PGO set
#                        cross-or-native: cross, falling back to MOZ_PGO=1
#                        empty: no PGO options
#
# License: MPL-2.0 (repo root LICENSE).

# Pinned clang toolchain (same pin as upstream — verified builds).
clang22="$HOME/.mozbuild/clang-22"
wasi_sysroot="$HOME/.mozbuild/sysroot-wasm32-wasi"

if [ -n "$fx_target" ]; then
    case "$fx_target" in
        *-linux-gnu) fx_os=linux ;;
        *-apple-darwin) fx_os=macos ;;
        *-windows-msvc) fx_os=windows ;;
        *) fx_os= ;;
    esac

    clang22_bin="$clang22/bin"
    clang22_cc="$clang22_bin/clang"
    clang22_cxx="$clang22_bin/clang++"

    export PATH="$clang22_bin:$PATH"
    if [ "$fx_os" = "windows" ]; then
        clang22_cl="$clang22_bin/clang-cl"
        export CC="$clang22_cl"
        export CXX="$clang22_cl"
        export HOST_CC="$clang22_cc"
        export HOST_CXX="$clang22_cxx"
    else
        export CC="$clang22_cc"
        export CXX="$clang22_cxx"
        export HOST_CC="$CC"
        export HOST_CXX="$CXX"
    fi
else
    # Local development and the release sign pipeline: the bootstrapped
    # toolchain may be absent, so fall back to the system clang.
    test "$fx_dev" = "1" || exit 1
    fx_os=

    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*)
            clang22_cc="$clang22/bin/clang.exe"
            clang22_cxx="$clang22/bin/clang++.exe"
            ;;
        *)
            clang22_cc="$clang22/bin/clang"
            clang22_cxx="$clang22/bin/clang++"
            ;;
    esac

    if [ "$(uname -m)" != "ppc64le" ]; then
        if [ -x "$clang22_cc" ] && [ -x "$clang22_cxx" ]; then
            export CC="$clang22_cc"
            export CXX="$clang22_cxx"
        else
            export CC=clang
            export CXX=clang++
        fi
        export HOST_CC="$CC"
        export HOST_CXX="$CXX"
    fi
fi

ac_add_options --with-wasi-sysroot="$wasi_sysroot"

if [ -n "$fx_target" ]; then
    if test "$FX_RELEASE" || test "$FX_PRE_RELEASE"; then
        ac_add_options --enable-lto${fx_lto_mode:+=$fx_lto_mode}
        ac_add_options --enable-optimize="$fx_optimize"
        ac_add_options --enable-release
        ac_add_options --enable-rust-simd
        ac_add_options RUSTC_OPT_LEVEL=3
        export MOZILLA_OFFICIAL=1
        if [ "$fx_rustc_bootstrap" = "1" ]; then
            mk_add_options "export RUSTC_BOOTSTRAP=1"
        fi
        if [ -n "$fx_rustflags" ]; then
            export RUSTFLAGS="$RUSTFLAGS $fx_rustflags"
        fi
    fi

    if [ "$fx_os" = "windows" ]; then
        ac_add_options --disable-bits-download
    fi
    if [ "$fx_os" = "windows" ] || [ "$fx_os" = "macos" ]; then
        ac_add_options --disable-update-agent
    fi
    ac_add_options --disable-crashreporter
    ac_add_options --disable-debug
    ac_add_options --disable-dmd
    ac_add_options --disable-geckodriver
    if [ "$fx_os" = "windows" ]; then
        ac_add_options --disable-maintenance-service
        ac_add_options --disable-parental-controls
    fi
    ac_add_options --disable-profiling
    ac_add_options --disable-tests

    if [ "$fx_os" = "linux" ]; then
        ac_add_options --enable-alsa
    fi
    if [ "$fx_os" != "windows" ]; then
        ac_add_options --enable-application=browser
    fi
    ac_add_options --enable-bootstrap=-clang,-sysroot-wasm32-wasi,-sccache
    if test -x "$(command -v sccache)"; then
        ac_add_options --with-ccache=sccache
    elif test -f "$HOME/.mozbuild/sccache/sccache"; then
        ac_add_options --with-ccache="$HOME"/.mozbuild/sccache/sccache
    fi
    if [ "$fx_os" = "windows" ]; then
        ac_add_options --enable-default-browser-agent
    fi
    ac_add_options --enable-install-strip
    if [ "$fx_pgo" = "native" ]; then
        ac_add_options MOZ_PGO=1
    elif [ "$fx_pgo" = "cross" ] || [ "$fx_pgo" = "cross-or-native" ]; then
        if test "$GEN_PGO"; then
            ac_add_options --enable-profile-generate=cross
        elif test "$USE_PGO"; then
            ac_add_options --enable-profile-use=cross
            ac_add_options --with-pgo-jarlog="$GITHUB_WORKSPACE"/en-US.log
            ac_add_options --with-pgo-profile-path="$GITHUB_WORKSPACE"/merged.profdata
        elif [ "$fx_pgo" = "cross-or-native" ]; then
            ac_add_options MOZ_PGO=1
        fi
    fi
    if [ "$fx_os" = "linux" ]; then
        ac_add_options --enable-linker=lld
        ac_add_options --enable-pulseaudio
    fi
    ac_add_options --enable-strip
    if test "$FX_RELEASE"; then
        ac_add_options --enable-update-channel=release
    elif test "$FX_PRE_RELEASE"; then
        ac_add_options --enable-update-channel=beta
    fi
    ac_add_options --enable-unverified-updates
    ac_add_options --enable-updater

    ac_add_options --target=$fx_target
else
    ac_add_options --disable-crashreporter
    ac_add_options --disable-debug
    ac_add_options --disable-dmd
    ac_add_options --disable-geckodriver
    ac_add_options --disable-profiling
    ac_add_options --disable-release
    ac_add_options --disable-updater

    ac_add_options --enable-application=browser
    ac_add_options --enable-bootstrap=-clang,-sysroot-wasm32-wasi
    ac_add_options --enable-optimize="-Os -w"
    ac_add_options --enable-tests
    ac_add_options --enable-unverified-updates
fi

# FOXAI app identity (mirrors upstream's waterfox/ block; our tree carries
# fork/ as foxai/ — see fork/BUILD.md step 1). Trademark-safe: our own
# name, our own fork/branding/ artwork, no Mozilla/Waterfox marks.
ac_add_options --with-app-basename=FoxAI Browser
ac_add_options --with-app-name=foxai-browser
ac_add_options --with-branding=foxai/browser/branding
ac_add_options --with-distribution-id=dev.foxai.browser
# FOXAI: local AI runs as an external KoboldCpp process (sidebar talks to
# localhost), not in-browser inference — onnx runtime stays off as upstream.
ac_add_options --without-onnx-runtime
if [ "$fx_os" = "windows" ]; then
    ac_add_options --with-redist
fi
if [ -d "$PWD"/foxai/browser/locales/en-GB ]; then
    ac_add_options --with-l10n-base="$PWD"/foxai/browser/locales
fi

if [ -n "$fx_target" ]; then
    export MOZ_INCLUDE_SOURCE_INFO=1
    if [ "$fx_cross_build" = "1" ]; then
        export CROSS_BUILD=1
    fi
    if [ "$fx_os" = "linux" ]; then
        export MOZ_NO_PIE_COMPAT=1
        export MOZ_STDCXX_COMPAT=1
    fi
    if [ "$fx_os" = "windows" ]; then
        export WINEDEBUG=-all
    fi
else
    if test -x "$(command -v sccache)"; then
        ac_add_options --with-ccache=sccache
    elif test -f "$HOME/.mozbuild/sccache/sccache"; then
        ac_add_options --with-ccache="$HOME"/.mozbuild/sccache/sccache
    fi

    mk_add_options AUTOCLOBBER=1
    mk_add_options MOZ_OBJDIR=./obj-"$(uname -s)"-"$(uname -m)"
fi

# Build-level privacy kills (same as upstream): no signing requirement,
# no telemetry reporting compiled in. Runtime behaviour is further locked
# by fork/user.js + fork/policies.json.
export MOZ_REQUIRE_SIGNING=
export MOZ_TELEMETRY_REPORTING=

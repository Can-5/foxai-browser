/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-5aWx3/A7rV7Tfw97CUV3oT1aysjwappdU6bCNDu/ugw='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; base-uri 'none'; form-action 'self'; object-src 'none'
  Cross-Origin-Opener-Policy: same-origin

/*.html
  Cache-Control: public, max-age=3600, must-revalidate

/*.css
  Cache-Control: public, max-age=86400, immutable

/*.js
  Cache-Control: public, max-age=86400, immutable

/*.svg
  Cache-Control: public, max-age=86400, immutable

/screenshots/*
  Cache-Control: public, max-age=604800, immutable

/og-image.*
  Cache-Control: public, max-age=604800, immutable

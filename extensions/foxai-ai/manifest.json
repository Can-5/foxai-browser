{
  "manifest_version": 2,
  "name": "FoxAI AI",
  "version": "1.1.0",
  "description": "Privacy-first AI sidebar: summarize, translate, explain, rewrite and chat.",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxai-ai@foxai.browser",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "storage",
    "tabs",
    "http://localhost/*",
    "http://localhost:11434/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_permissions": ["<all_urls>"],
  "background": {
    "scripts": ["lib/providers.js", "background.js"]
  },
  "sidebar_action": {
    "default_title": "FoxAI AI",
    "default_panel": "sidebar/foxai-ai.html",
    "default_icon": "icons/ai-32.png"
  },
  "icons": {
    "32": "icons/ai-32.png",
    "64": "icons/ai-64.png"
  }
}
